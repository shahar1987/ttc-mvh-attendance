{
  "extraKnownMarketplaces": {
    "ttc-mods": {
      "source": {
        "source": "github",
        "repo": "shahar1987/ttc-mvh-attendance"
      }
    },
    "open-code-review": {
      "source": {
        "source": "github",
        "repo": "alibaba/open-code-review"
      }
    },
    "elementalsouls": {
      "source": {
        "source": "github",
        "repo": "elementalsouls/Claude-BugHunter"
      }
    }
  },
  "enabledPlugins": {
    "context-alarm@ttc-mods": true,
    "open-code-review@open-code-review": true,
    "claude-bughunter@elementalsouls": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v ocr >/dev/null 2>&1 || npm install -g --ignore-scripts @alibaba-group/open-code-review@1.13.10 >/dev/null 2>&1 || true",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
