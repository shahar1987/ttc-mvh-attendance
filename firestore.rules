rules_version = '2';

// כללי אבטחה — מועדון טניס שולחן מבואות החרמון
//
// לפריסה: העתקה ל-Firebase Console > Firestore > Rules > Publish.
// הקובץ הזה הוא המקור — לערוך כאן ולא בקונסולה, כך שיש היסטוריה.
//
// שמות האוספים כאן נבדקו מול הקוד: users, groups, players, attendance,
// cancellations, announcements, paymentMappings, links, invites,
// accessRequests, reminders, adminTasks, system, auditLog, tournaments,
// boardMembers, boardMemberMatches, eventSignups, eventSignupExports, pushTokens, boardPublic, boardPosts,
// boardImages, pushRequests, boardManagers, boardVisits. אוסף שלא מופיע
// כאן חסום לחלוטין על ידי הכלל האחרון.
//
// שני עקרונות שחוזרים לאורך הקובץ:
// 1. הורה (תפקיד "Member") לא רואה כרטיסי שחקנים או נוכחות — פורטל ההורים הוסר ב-10.10.2026.
// 2. כשבודקים בעלות על מסמך קיים בודקים את resource.data — מה שכתוב כרגע
//    במסד — ולא את request.resource.data, שהוא מה שהבקשה מבקשת לכתוב.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- עזר ----------

    function isSignedIn() {
      return request.auth != null;
    }

    // קריאה אחת של מסמך המשתמש שמשרתת גם את hasProfile וגם את me.
    // Firestore מגביל כלל לעשר קריאות מסמך לכל בקשה, ולכן חשוב לא לכפול:
    // get יחיד מחזיר null כשהמסמך חסר, וזה כל מה שצריך כדי לבדוק קיום.
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // יש למשתמש פרופיל מאושר במערכת. קריאה של נתוני המועדון דורשת את זה —
    // לא מספיק להיות מחובר עם חשבון גוגל כלשהו.
    function hasProfile() {
      return isSignedIn() && userDoc() != null;
    }

    function me() {
      return userDoc().data;
    }

    // התפקיד נשמר באפליקציה כ-"Admin"/"Coach"/"Viewer"/"Member", אבל
    // ההשוואה כאן חסינה לאותיות גדולות/קטנות כדי שמסמך ישן לא ינעל אף אחד.
    function roleIs(r) {
      return hasProfile() && me().get('role', '').lower() == r;
    }

    function isAdmin() {
      return roleIs('admin');
    }

    // גולש אמיתי עם חשבון גוגל מאומת — לא חשבון אנונימי שנוצר בסקריפט (הגנה מהצפה)
    function isGoogleUser() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }

    // בעל לוח המועדון (דף הניהול בפורטל): חשבון גוגל מאומת שה-SHA-256 של האימייל שלו (באותיות קטנות)
    // שמור ב-system/boardOwner.hash. בקוד ובמסד — רק ה-hash, לא האימייל. מסמך חסר = אף אחד.
    function isBoardOwner() {
      return isGoogleUser()
        && hashing.sha256(request.auth.token.email.lower().toUtf8()).toHexString().lower()
           == get(/databases/$(database)/documents/system/boardOwner).data.hash;
    }

    // מנהל בלוח: מי שבעל הלוח הוסיף בדף הניהול (boardManagers/{gmail באותיות קטנות}). רק מפרסם ועורך עדכונים.
    function isBoardManager() {
      return isGoogleUser()
        && exists(/databases/$(database)/documents/boardManagers/$(request.auth.token.email.lower()));
    }

    // טקסט חופשי שלא נפתח כנוסחה בגיליון (= + - @ או טאב בהתחלה)
    function noFormula(v) {
      return !v.matches('[=+@\\t-].*');
    }

    // צוות המועדון: מנהל, מאמן, צופה — כל מי שאינו הורה/שחקן.
    // ההשוואה היא "שונה מ-member" ולא רשימה סגורה, בדיוק כמו isMemberRole
    // שבקוד, כדי שתפקיד שנכתב בטעות לא ינעל משתמש קיים מחוץ למערכת.
    function isTeam() {
      return hasProfile() && me().get('role', '').lower() != 'member';
    }

    // הרשאה פרטנית שהמנהל פותח לכל משתמש בנפרד, במסך "ניהול הרשאות".
    // הערכים: reports, payments, phonebook, manageGroups, competitions,
    //         sendMessages, access, boardPosts — זהים ל-APP_PERMISSIONS שבקוד.
    function hasPerm(p) {
      return hasProfile() && (
        me().get('role', '').lower() == 'admin' ||
        p in me().get('permissions', [])
      );
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId));
    }

    function isCoachOfGroup(groupId) {
      return hasProfile()
        && groupId is string && groupId != ''
        && groupDoc(groupId) != null
        && (groupDoc(groupId).data.get('coachId', '') == request.auth.uid
            || request.auth.uid in groupDoc(groupId).data.get('coachIds', []));
    }

    // הורה מקושר לכרטיס שחקן דרך מסמך ב-links שמזהה אותו: uid_playerId.
    // פורטל ההורים הוסר (10.10.2026): קישור הורה-שחקן כבר לא פותח גישה לכרטיס.
    function isLinkedToPlayer(playerId) {
      return false;
    }

    // גישה לתחרויות — אותו היגיון כמו userPermissions() ב-part-b.js:
    // מנהל, או הרשאת "competitions" מפורשת, או — למי שעוד לא נקבעו לו
    // הרשאות פרטניות — ברירת המחדל של התפקיד, שלמאמן ולצופה כוללת תחרויות.
    // בלי הסעיף האחרון מאמן חדש רואה את התחרויות באפליקציה אבל נחסם בשמירה.
    function canCompete() {
      return hasPerm('competitions')
        || (hasProfile()
            && !(me().get('permissions', null) is list)
            && me().get('role', '').trim().lower() in ['coach', 'viewer']);
    }

    // ---------- משתמשים ----------
    // כל אחד קורא את הפרופיל של עצמו — בלי זה האפליקציה לא יכולה לדעת מי הוא.
    // רשימת המשתמשים, עם שמות וטלפונים, נפתחת לצוות בלבד.
    // רק מנהל משנה תפקידים והרשאות — אחרת מאמן יוכל להעניק לעצמו גישה לכל דבר.
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isTeam());
      allow list: if isTeam();

      // הרשמה דרך קישור הזמנה: המוזמן יוצר לעצמו פרופיל של "Member" בלבד,
      // ורק אם הוא מצמיד אליו טוקן הזמנה חי. בלי הסעיף הזה אי אפשר להירשם
      // כלל, כי משתמש חדש אינו מנהל ואין מי שייצור עבורו את המסמך.
      // אין יותר הרשמה עצמית דרך הזמנה (פורטל ההורים הוסר) — רק מנהל יוצר פרופיל.
      allow create: if isAdmin();

      allow delete: if isAdmin();
      allow update: if isAdmin()
        // משתמש רגיל רשאי לעדכן רק את טוקן ה-Push שלו
        || (request.auth.uid == userId
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['fcmToken']));
    }

    // ---------- קבוצות ----------
    // שם, מקום, ימים ושעות. אין כאן פרטי שחקנים, וההורה בפורטל צריך את
    // הקבוצה של הילד — ולכן הקריאה פתוחה לכל בעל פרופיל.
    match /groups/{groupId} {
      allow read: if hasProfile();
      allow create, delete: if hasPerm('manageGroups');
      // מאמן רשאי לערוך את הקבוצה שלו, אבל לא להעביר אותה למאמן אחר
      allow update: if hasPerm('manageGroups')
        || (isCoachOfGroup(groupId)
            && request.resource.data.get('coachId', '') == resource.data.get('coachId', '')
            && request.resource.data.get('coachIds', []) == resource.data.get('coachIds', []));
    }

    // ---------- שחקנים ----------
    // שם הילד, טלפון ההורה והשיוך לקבוצה. רשימת כל השחקנים היא לצוות בלבד,
    // ולמי שהמנהל פתח לו במפורש הרשאת "תחרויות" (הייבוא באפליקציית התחרויות).
    // הורה קורא רק את הכרטיסים של הילדים שקושרו אליו.
    // הרשאת payments נכללת בעריכה כי מסך "מי לא משלם" מסמן notPaying ומתקן שמות —
    // רק השדות האלה, ולא קבוצה, טלפון וכו' של כל שחקן במועדון (18.10).
    function paymentFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['notPaying', 'notPayingSource', 'paymentSettledAt', 'name']);
    }
    match /players/{playerId} {
      allow get: if isTeam() || hasPerm('competitions') || isLinkedToPlayer(playerId);
      allow list: if isTeam() || hasPerm('competitions');
      allow create: if hasPerm('manageGroups')
        || isCoachOfGroup(request.resource.data.get('groupId', ''));
      // מאמן עורך רק שחקן שכבר בקבוצה שלו, ואינו מעביר אותו לקבוצה אחרת
      allow update: if hasPerm('manageGroups')
        || (hasPerm('payments') && paymentFieldsOnly())
        || (isCoachOfGroup(resource.data.get('groupId', ''))
            && request.resource.data.get('groupId', '') == resource.data.get('groupId', ''));
      allow delete: if isAdmin();
    }

    // ---------- נוכחות ----------
    // הדאטה הקריטית ביותר. הורה רואה רק את הנוכחות של הילדים המקושרים אליו;
    // האפליקציה שואלת לפי playerId, והכלל נבדק על כל מסמך שמוחזר.
    // מחיקה — רק מנהל.
    // חוזה השמירה ביצירה (גם למנהל): מזהה המסמך הוא date_groupId_playerId
    // בדיוק כמו השדות שבו, והסטטוס Present או Absent.
    function attendanceValid(attendanceId) {
      return request.resource.data.get('status', '') in ['Present', 'Absent']
        && request.resource.data.get('date', '') is string
        && request.resource.data.get('groupId', '') is string
        && request.resource.data.get('playerId', '') is string
        && attendanceId == request.resource.data.get('date', '') + '_'
             + request.resource.data.get('groupId', '') + '_'
             + request.resource.data.get('playerId', '');
    }

    // רשומה קיימת לא עוברת לשחקן, לתאריך או לקבוצה אחרים. null בשני הצדדים
    // כדי שרשומה ישנה שחסר בה שדה עדיין תתעדכן.
    function attendanceKeysUnchanged() {
      return request.resource.data.get('date', null) == resource.data.get('date', null)
        && request.resource.data.get('groupId', null) == resource.data.get('groupId', null)
        && request.resource.data.get('playerId', null) == resource.data.get('playerId', null);
    }

    // בעדכון לא דורשים את החוזה המלא — ייתכנו רשומות ישנות שלא נוכל לבדוק.
    // סטטוס שלא נגעו בו נשאר כמו שהוא; סטטוס שמשתנה חייב להיות Present/Absent.
    function attendanceStatusOk() {
      return request.resource.data.get('status', null) == resource.data.get('status', null)
        || request.resource.data.get('status', null) in ['Present', 'Absent'];
    }

    match /attendance/{attendanceId} {
      allow read: if isTeam() || isLinkedToPlayer(resource.data.get('playerId', ''));
      allow create: if attendanceValid(attendanceId)
        && (isAdmin()
            || isCoachOfGroup(request.resource.data.get('groupId', '')));
      // בעדכון בודקים את הקבוצה של המסמך הקיים, ולא של הבקשה — אחרת מאמן
      // יכול למשוך אליו כל רשומה במועדון פשוט על ידי כתיבת ה-groupId שלו.
      allow update: if attendanceKeysUnchanged()
        && attendanceStatusOk()
        && (isAdmin()
            || isCoachOfGroup(resource.data.get('groupId', '')));
      allow delete: if isAdmin();
    }

    // ---------- ביטולי אימונים ----------
    // ביטול נוצר עם groupId, וביטול הביטול מוחק את אותו מסמך — ולכן
    // במחיקה ובעדכון בודקים את הקבוצה של המסמך הקיים ולא של הבקשה.
    match /cancellations/{id} {
      allow read: if hasProfile();
      allow create: if isAdmin()
        || isCoachOfGroup(request.resource.data.get('groupId', ''));
      allow update: if isAdmin()
        || (isCoachOfGroup(resource.data.get('groupId', ''))
            && request.resource.data.get('groupId', '') == resource.data.get('groupId', ''));
      allow delete: if isAdmin()
        || isCoachOfGroup(resource.data.get('groupId', ''));
    }

    // ---------- דוחות ----------
    // הדוחות מחושבים מהנתונים הקיימים ואין להם אוסף נפרד, ולכן ההרשאה
    // 'reports' נאכפת בממשק בלבד. הנתונים עצמם מוגנים על ידי הכללים של
    // attendance ו-players.

    // ---------- בדיקת תשלומים ----------
    // נתוני תשלומים — רק למי שרואה את מסך "מי לא משלם" (PaymentsScreen נפתח רק עם הרשאת payments)
    match /paymentMappings/{id} {
      allow read: if hasPerm('payments');
      allow write: if hasPerm('payments');
    }

    // ---------- הודעות המועדון ----------
    // כל בעל פרופיל קורא (גם הורים), כותב רק מי שיש לו הרשאת הודעות,
    // ועורך/מוחק רק המנהל או מי שכתב את ההודעה.
    match /announcements/{id} {
      allow read: if hasProfile();
      allow create: if hasPerm('sendMessages')
        && request.resource.data.get('authorUid', '') == request.auth.uid;
      allow update, delete: if isAdmin()
        || (hasPerm('sendMessages')
            && resource.data.get('authorUid', '') == request.auth.uid);
    }

    // ---------- תזכורות למאמנים ----------
    match /reminders/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ---------- יומן פעולות ----------
    // כל משתמש מחובר יכול לכתוב רישום, רק מנהל קורא.
    // אסור לערוך או למחוק — יומן שאפשר לשנות חסר ערך.
    match /auditLog/{id} {
      // שום קוד לא כותב ליומן הזה (נבדק 13.10.2026) — סגור לכתיבה כדי שאי אפשר יהיה לזייף בו רשומות
      allow create: if false;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- גישת הורים (הוסרה 10.10.2026) ----------
    // הנתונים הישנים נשארים, אבל רק המנהל קורא, מתקן או מוחק אותם.
    match /links/{linkId} {
      allow read, write: if isAdmin();
    }
    match /invites/{token} {
      allow read, write: if isAdmin();
    }
    match /accessRequests/{id} {
      allow read, update, delete: if isAdmin();
    }

    // ---------- מערכת ----------
    // מסמכי מצב של הסנכרון (paymentSync, paymentSnapshot, paymentSyncRequest,
    // paymentSyncIgnores, זריעות). נקראים במסכי הצוות, נכתבים על ידי המנהל
    // או בעל הרשאת התשלומים; סקריפטי ה-Admin SDK עוקפים את הכללים ממילא.
    // 📝 טופס ההצטרפות (worker/src/join.js): הבקשות נכתבות רק בשרת של שולה (service account),
    // אף אחד לא כותב אליהן מהדפדפן. המנהל קורא, מאשר (יוצר שחקן כרגיל) ומוחק.
    match /joinRequests/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }
    // הגדרות הטופס (קוד סודי, קבוצות, טלפון לשאלות) ומגבלת הקצב — מנהל בלבד
    match /joinConfig/{id} {
      allow read, write: if isAdmin();
    }
    match /system/{id} {
      allow read: if hasPerm('payments');
      allow write: if hasPerm('payments');
    }
    match /adminTasks/{id} {
      allow read, write: if isAdmin();
    }

    // ---------- תחרויות ----------
    // אפליקציית "תן לי שולחן" (ttc-mvh-tournaments). כל חבר מועדון רשום
    // יכול לנהל תחרות, אבל מחיקה — רק למי שיש לו הרשאת "תחרויות", כדי
    // שהורה לא יוכל למחוק את התחרויות של המועדון.
    // המסמך zz-connection-test הוא בדיקת החיבור של האפליקציה.
    // state הוא תמיד מחרוזת JSON (pushCloud). אין מגבלת גודל: תחרות גדולה
    // יכולה להתקרב למגבלת המסמך של Firestore עצמו (1MiB), וכל מגבלה נמוכה
    // ממנה עלולה לחסום שמירה אמיתית באמצע תחרות.
    match /tournaments/{id} {
      allow read: if hasProfile();
      // רק מי שיש לו גישה לתחרויות באפליקציה (canCompete). חשבון Member לא כותב.
      allow create, update: if canCompete()
        && request.resource.data.get('state', '') is string;
      allow delete: if hasPerm('competitions');
    }
    // עותק לצפייה של תחרות (קישור פתוח, בלי התחברות). האפליקציה כותבת אותו
    // רק כשמסמנים "קישור צפייה" בהגדרות, עם שמות מקוצרים (שם פרטי ואות).
    match /tournamentsPublic/{id} {
      allow get: if true;
      allow create, update: if canCompete()
        && request.resource.data.get('state', '') is string;
      allow delete: if hasPerm('competitions');
    }

    // טופס מידות תלבושת ליגה (shahar1987.github.io/ttc-uniform-sizes).
    // הורים רק שולחים מילוי; המנהל קורא, עורך מידות, משייך לשחקן ומוחק.
    match /uniformResponses/{id} {
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['first','last','shirt','pants','at'])
        && request.resource.data.first is string && request.resource.data.first.size() > 0 && request.resource.data.first.size() <= 40
        && request.resource.data.last is string && request.resource.data.last.size() <= 40
        && request.resource.data.shirt is string && request.resource.data.shirt.size() <= 20
        && request.resource.data.pants is string && request.resource.data.pants.size() <= 20
        && request.resource.data.at == request.time);
      allow read, update, delete: if isAdmin();
    }
    // רשימת השחקנים של הטופס, אחרי עריכות המאמן (uniformConfig/roster).
    match /uniformConfig/{id} {
      allow read, write: if isAdmin();
    }

    // ---------- נרשמים בלוח המועדון (אתר ציבורי נפרד, כניסה עם גוגל) ----------
    // לגולש אין פרופיל ב-users, ולכן hasProfile() נכשל לו בכל אוסף אחר.
    // כאן הוא כותב רק את המסמך של עצמו, רק בשדות האלה, וקורא/מוחק רק אותו (זכות להישכח).
    // הטלפון: אחרי הסרת רווחים ומקפים — נייד ישראלי (05XXXXXXXX / 9725XXXXXXXX / +9725XXXXXXXX).
    function boardMemberValid() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'phone', 'photo', 'consent', 'ref', 'createdAt', 'updatedAt'])
        && d.get('name', null) is string && d.name.size() > 0 && d.name.size() <= 80
        && noFormula(d.name)
        && d.get('email', null) is string && d.email.size() <= 120
        && d.get('email', null) == request.auth.token.email
        && d.get('phone', null) is string && d.phone.size() <= 20
        && d.phone.matches('[0-9+ -]+')
        && d.phone.replace('[ -]', '').matches('(\\+?972|0)5[0-9]{8}')
        && (!('photo' in d) || (d.photo is string && d.photo.size() <= 500))
        && d.get('consent', false) == true
        && d.get('updatedAt', null) == request.time;
    }
    match /boardMembers/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isBoardOwner();
      // ref (רשות) — ה-uid של מי שהזמין ("הבאת חבר"). נקבע רק ביצירה, לא אתה עצמך.
      allow create: if isGoogleUser() && request.auth.uid == uid
        && boardMemberValid()
        && (!('ref' in request.resource.data)
            || (request.resource.data.ref is string
                && request.resource.data.ref.matches('[A-Za-z0-9]{10,128}')
                && request.resource.data.ref != uid))
        && request.resource.data.get('createdAt', null) == request.time;
      // createdAt ו-ref לא משתנים בעדכון (גם לא נוספים או נמחקים)
      allow update: if (isGoogleUser() && request.auth.uid == uid
          && boardMemberValid()
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && request.resource.data.get('ref', null) == resource.data.get('ref', null))
        || isBoardOwner();
      allow delete: if (isSignedIn() && request.auth.uid == uid) || isBoardOwner();
    }
    // תוצאת ההתאמה לשחקן — נכתבת רק בסקריפט (scripts/match_board_members.mjs, Admin SDK).
    match /boardMemberMatches/{uid} {
      allow read: if isBoardOwner();
      allow write: if false;
    }

    // ---------- הרשמה לאירועי המועדון (מרוץ העגור וכו') מלוח המועדון ----------
    // הגולש רושם את עצמו ובני משפחה: מסמך לכל משתתף, מזהה event_uid_n (n בין 1 ל-8).
    // לא אוספים ת.ז לעולם. אין עדכון — מוחקים ונרשמים מחדש.
    // הייצוא לגיליון של המארגנים — בסקריפט (scripts/export_event_signups.mjs, Admin SDK).
    function eventSignupValid(id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['event', 'uid', 'n', 'firstName', 'lastName', 'heat', 'gender', 'birth',
                               'city', 'phone', 'email', 'shirt', 'byName', 'createdAt'])
        && d.get('uid', null) == request.auth.uid
        && d.get('event', null) is string && d.event.matches('[a-z0-9-]{3,40}')
        && d.event in ['crane-2026']
        && d.get('n', null) is int && d.n >= 1 && d.n <= 8
        && id == d.event + '_' + request.auth.uid + '_' + string(d.n)
        && d.get('firstName', null) is string && d.firstName.size() > 0 && d.firstName.size() <= 40
        && d.get('lastName', null) is string && d.lastName.size() > 0 && d.lastName.size() <= 40
        && d.get('heat', null) is string && d.heat.size() > 0 && d.heat.size() <= 20
        && d.get('gender', null) in ['ז', 'נ']
        && d.get('birth', null) is string && d.birth.matches('[0-9]{1,2}[./][0-9]{1,2}[./][0-9]{4}')
        && d.get('city', null) is string && d.city.size() <= 40
        && d.get('phone', null) is string && d.phone.size() <= 20
        && d.phone.matches('[0-9+ -]+')
        && d.phone.replace('[ -]', '').matches('(\\+?972|0)5[0-9]{8}')
        && d.get('email', null) is string && d.get('email', null) == request.auth.token.email
        && d.get('shirt', null) in ['XS', 'S', 'M', 'L', 'XL', 'XXL',
                                    'ילדים 6', 'ילדים 8', 'ילדים 10', 'ילדים 12', 'ילדים 14']
        && d.get('byName', null) is string && d.byName.size() <= 80
        && noFormula(d.firstName) && noFormula(d.lastName) && noFormula(d.heat)
        && noFormula(d.city) && noFormula(d.byName)
        && d.get('createdAt', null) == request.time;
    }
    match /eventSignups/{id} {
      // רק מי שכבר הצטרף ללוח (boardMembers) — חשבון גוגל מאומת
      allow create: if isGoogleUser() && eventSignupValid(id)
        && exists(/databases/$(database)/documents/boardMembers/$(request.auth.uid));
      allow read, delete: if (isSignedIn() && resource.data.uid == request.auth.uid) || isBoardOwner();
      allow update: if false;
    }
    // מה כבר הועבר לגיליון — נכתב רק בסקריפט
    match /eventSignupExports/{id} {
      allow read: if isBoardOwner();
      allow write: if false;
    }

    // ---------- נתונים ציבוריים של לוח המועדון ----------
    // referrals: טבלת "הבאת חבר" של החודש (שם פרטי ואות בלבד). נכתב רק בסקריפט (scripts/referrals.mjs).
    match /boardPublic/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- התראות דחיפה של לוח המועדון (FCM) ----------
    // הגולש לא בהכרח מחובר: הדפדפן שומר את טוקן ה-FCM שלו כמזהה המסמך, בלי שום פרט אישי.
    // setDoc חוזר על אותו טוקן הוא עדכון ונחסם — הלקוח מתעלם מהשגיאה.
    // השליחה והניקוי של טוקנים מתים — בסקריפט (scripts/send_push.mjs, Admin SDK).
    match /pushTokens/{token} {
      allow create: if token.size() >= 100 && token.size() <= 400
        && token.matches('[A-Za-z0-9_:\\-]+')
        && request.resource.data.keys().hasOnly(['createdAt', 'platform'])
        && request.resource.data.get('createdAt', null) == request.time
        && (!('platform' in request.resource.data)
            || request.resource.data.platform in ['android', 'ios', 'desktop']);
      allow read, update, delete: if isBoardOwner();
    }

    // ---------- עדכונים בלוח המועדון הציבורי ----------
    // הלוח (ריפו נפרד) קורא בלי התחברות. כותב רק בעל הלוח (isBoardOwner).
    function boardPostValid() {
      let d = request.resource.data;
      let keys = ['title', 'text', 'banner', 'pin', 'hidden', 'link', 'linkText',
                  'date', 'author', 'authorName', 'updatedAt', 'createdAt'];
      // רשות: img — מזהה תמונה ב-boardImages; popup — חלון קופץ עם הרשמה לאירוע
      return d.keys().hasOnly(keys.concat(['img', 'popup'])) && d.keys().hasAll(keys)
        && (!('img' in d) || (d.img is string && d.img.matches('[A-Za-z0-9_-]{1,40}')))
        && (!('popup' in d) || (d.popup is map
            && d.popup.keys().hasOnly(['event', 'heats', 'until']) && d.popup.keys().hasAll(['event', 'heats'])
            && d.popup.event is string && d.popup.event.matches('[a-z0-9-]{3,40}')
            && d.popup.heats is list && d.popup.heats.size() >= 1 && d.popup.heats.size() <= 6
            && (!('until' in d.popup) || (d.popup.until is string && d.popup.until.matches('(\\d{4}-\\d{2}-\\d{2})?')))))
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 90
        && d.text is string && d.text.size() <= 1200
        && d.banner is bool && d.pin is bool && d.hidden is bool
        && d.link is string
        && (d.link == '' || (d.link.size() <= 300 && d.link.matches('https://.*')))
        && d.linkText is string && d.linkText.size() <= 30
        && d.date is string && d.date.matches('\\d{4}-\\d{2}-\\d{2}')
        && d.date >= '2025-01-01' && d.date <= '2030-12-31'
        && d.author == request.auth.uid
        && d.authorName is string && d.authorName.size() <= 60
        && d.updatedAt == request.time;
    }
    match /boardPosts/{id} {
      // הלוח שואל עם where hidden == false; מוסתר — רק לבעלים. כותב רק הבעלים מדף הניהול בפורטל
      // (20.10.2026: הפורטל יצא ממערכת הנוכחות, גם המסך והרשאת boardPosts שם הוסרו)
      allow get, list: if resource.data.hidden == false || isBoardOwner() || isBoardManager();
      allow create: if (isBoardOwner() || isBoardManager()) && boardPostValid()
        && request.resource.data.createdAt == request.time;
      allow update: if (isBoardOwner() || isBoardManager()) && boardPostValid()
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isBoardOwner() || isBoardManager();
    }

    // תמונות לעדכונים בלוח (data URL דחוס, עד ~700KB). כל אחד קורא לפי מזהה; רק הבעלים מעלה ומוחק.
    match /boardImages/{id} {
      allow get: if true;
      allow list, update: if false;
      allow create: if (isBoardOwner() || isBoardManager()) && id.matches('[A-Za-z0-9_-]{1,40}')
        && request.resource.data.keys().hasOnly(['data', 'createdAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 700000
        && request.resource.data.data.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+')
        && request.resource.data.createdAt == request.time;
      allow delete: if isBoardOwner() || isBoardManager();
    }

    // כניסות לפורטל (21.10.2026, שלום אישר): מסמך אחד למכשיר ליום (מזהה = v_day). כל אחד רק מוסיף,
    // עם שם מלא שהמבקר הקליד פעם אחת (רשות). רק בעל הלוח קורא ומוחק. אין עדכון.
    match /boardVisits/{id} {
      allow read, delete: if isBoardOwner();
      allow update: if false;
      allow create: if request.resource.data.keys().hasOnly(['v', 'day', 'n', 'r', 'd', 'at'])
        && request.resource.data.keys().hasAll(['v', 'day', 'at'])
        && request.resource.data.v is string && request.resource.data.v.matches('[a-z0-9]{6,16}')
        && request.resource.data.day is string && request.resource.data.day.matches('20[0-9]{6}')
        && id == request.resource.data.v + '_' + request.resource.data.day
        && (!('n' in request.resource.data) || (request.resource.data.n is string && request.resource.data.n.size() <= 60))
        && (!('r' in request.resource.data) || request.resource.data.r in ['הורה', 'שחקן/ית', 'מאמן/ת', 'אחר'])
        && (!('d' in request.resource.data) || (request.resource.data.d is string && request.resource.data.d.size() <= 10))
        && request.resource.data.at == request.time;
    }

    // מנהלים שבעל הלוח הוסיף (מזהה = כתובת הג'ימייל). הבעלים מנהל; כל מנהל רואה רק את המסמך של עצמו.
    match /boardManagers/{email} {
      allow read: if isBoardOwner() || (isGoogleUser() && email == request.auth.token.email.lower());
      allow create, update: if isBoardOwner()
        && email.matches('[a-z0-9._%+-]+@[a-z0-9.-]+[.][a-z]{2,}')
        && request.resource.data.keys().hasOnly(['name', 'addedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.addedAt == request.time;
      allow delete: if isBoardOwner();
    }

    // בקשות התראת דחיפה מדף הניהול. הסקריפט (scripts/send_push.mjs --queue, Admin SDK) שולח ומסמן.
    match /pushRequests/{id} {
      allow create: if isBoardOwner()
        && request.resource.data.keys().hasOnly(['title', 'body', 'url', 'createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 60
        && request.resource.data.body is string && request.resource.data.body.size() <= 180
        && request.resource.data.url is string && request.resource.data.url.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow read: if isBoardOwner();
      allow update, delete: if false;
    }

    // כל השאר חסום. אוסף חדש דורש כלל מפורש כאן.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
